# What a Vercel deployment leaves out. The Next.js build needs app/,
# components/, hooks/, lib/, types/, api/client.ts and data/*.ts; the Python
# function needs api/index.py, api/requirements.txt and prism/.
.venv
__pycache__
*.pyc
*.db
*.xlsx
runs/
tests/
docs/
migrations/
scripts/
data/drivers/
data/calibration/
_*
