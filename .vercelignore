# What a Vercel deployment leaves out. The Next.js build needs app/,
# components/, hooks/, lib/, types/ and data/*.ts; the Python function needs
# api/index.py, api/requirements.txt and prism/. Secrets never leave the
# machine, whether the deployment comes from git or the Vercel CLI.
# A pattern without a leading slash matches at every depth, so the folders
# are anchored to the root (tests/test_repository.py checks what is left out).
.env
.env.*
.venv
__pycache__
*.pyc
*.db
*.xlsx
*.dump
/runs/
/tests/
/docs/
/migrations/
/scripts/
/data/drivers/
/data/parameters/
/data/content/
/_*
