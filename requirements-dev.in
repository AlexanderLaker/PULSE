# Everything needed to develop and test PRISM: the engine, the production run,
# the API and the test suite. This file holds the ranges; requirements-dev.txt
# pins the exact versions that CI and developers install. After a change here,
# regenerate it (docs/OPERATIONS.md, "Dependencies"):
#   uv pip compile requirements-dev.in --universal --python-version 3.11 -o requirements-dev.txt

# Engine and production run. numpy and scipy stay at the versions the golden
# pins and the reference run were computed with, and move only with a model
# release (docs/adr/0014-versioning-and-golden-pins.md).
numpy==2.4.6
scipy==1.17.1           # the engine's distributions; there is no fallback
openpyxl>=3.1,<4        # the QA workbook
python-dotenv>=1.0,<2   # loads .env in the command-line scripts

