# Dependencies, caches and build output
node_modules/
.next/
.vercel/
*.tsbuildinfo
# Written by next dev and next build (differently), so never committed
next-env.d.ts
__pycache__/
*.pyc
.venv/
.pytest_cache/
.hypothesis/

# Secrets: only the template is tracked
.env
.env.*
!.env.example
/.clerk/

# Local SQLite databases and their side files
*.db
*.db-journal
*.db-wal
*.db-shm

# Outputs that can hold confidential figures or personal data: production run
# workbooks, and the archives the migrations write
runs/
*.xlsx
archive/

# Handover package (scripts/package_handover.sh)
PRISM_HANDOVER_*.zip

# Local working folders and files (prefixed with an underscore), editors, OS
/_*
.claude/settings.local.json
.claude/worktrees/
.DS_Store
.~lock.*#
~$*
*.log
*.bak
