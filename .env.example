# Copy to .env and fill in; .env is never committed. README.md explains each
# variable. On Vercel the same variables are set in the project settings.

# Clerk (sign-in)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# The Neon PostgreSQL database (the API, the production run and the dashboard's role table)
DATABASE_URL=
# The same under another name; wins over DATABASE_URL when both are set
POSTGRES_URL=

# Signs the tokens between the dashboard and the API; at least 32 characters.
# Generate one: python3 -c 'import secrets; print(secrets.token_urlsafe(64))'
PRISM_JWT_SECRET=

# The code new users enter on the sign-up page
NEXT_PUBLIC_SIGNUP_CODE=
# Enables /api/admin/bootstrap while set; remove it once the first admin exists
ADMIN_BOOTSTRAP_SECRET=

# Optional: the origin the dashboard's admin routes call the API on (for
# example https://prism-hcb.vercel.app); without it they call the host the
# request came in on. On Vercel set it for Production only
PRISM_API_ORIGIN=

# Local development only
# The API server behind the dashboard's /api/v1 rewrite (default http://127.0.0.1:8000)
PRISM_LOCAL_API_URL=
# The SQLite file used when both database URLs are empty (default data/prism.db)
PRISM_DB_PATH=
# 1 serves the API's interactive documentation at /docs; leave it unset on any deployment
PRISM_API_DOCS=
