# PRISM — Environment Variables
# Copy to .env and fill in. See README.md ("Environment variables") for details.

# ── Auth (Clerk) — required ──────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# ── Database (Neon Postgres) — required ──────────────────────────
DATABASE_URL=

# ── Clerk → Engine auth bridge — required (>= 32 chars) ──────────
# Generate: python -c 'import secrets; print(secrets.token_urlsafe(64))'
PRISM_JWT_SECRET=

# ── Access control ───────────────────────────────────────────────
NEXT_PUBLIC_SIGNUP_CODE=
ADMIN_BOOTSTRAP_SECRET=

# ── Local development ────────────────────────────────────────────
# Engine URL for the Next.js dev proxy (default http://127.0.0.1:8000)
PRISM_BACKEND_URL=
# SQLite fallback for engine runs without Postgres
PRISM_DB_PATH=
