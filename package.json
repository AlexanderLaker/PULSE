{
  "name": "prism",
  "version": "2.12.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0 && bash scripts/check_single_source.sh",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "test": "vitest run",
    "test:py": "python3 -m pytest -q -n auto",
    "lint:py": "ruff check .",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run lint:py && npm run test:py"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.39.7",
    "@neondatabase/serverless": "^1.2.0",
    "framer-motion": "^12.43.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.56.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^2.15.4",
    "svix": "^1.99.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.4.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  }
}
